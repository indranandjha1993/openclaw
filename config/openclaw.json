// Mounted read-only. Secrets and machine-specific values come from .env.
{
  "gateway": {
    "mode": "local",
    // Listen on all interfaces inside the container; compose only publishes
    // the port on 127.0.0.1.
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:${OPENCLAW_PORT:-18789}",
        "http://127.0.0.1:${OPENCLAW_PORT:-18789}"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "lm-studio": {
        "baseUrl": "${LM_STUDIO_URL:-http://host.docker.internal:1234/v1}",
        "apiKey": "${LM_STUDIO_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen/qwen3.5-9b",
            "name": "Qwen 3.5 9B (Local)",
            "contextWindow": 32768,
            "maxTokens": 4096
          },
          {
            "id": "nvidia/nemotron-3-nano-4b",
            "name": "Nemotron 3 Nano 4B (Local)",
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${OPENCLAW_MODEL:-lm-studio/qwen/qwen3.5-9b}",
        "fallbacks": [
          "mistral/mistral-small-latest",
          "google/gemini-2.5-flash"
        ]
      },
      "models": {
        "lm-studio/qwen/qwen3.5-9b": {},
        "lm-studio/nvidia/nemotron-3-nano-4b": {},
        "mistral/mistral-small-latest": {},
        "mistral/mistral-medium-latest": {},
        "mistral/mistral-large-latest": {},
        "mistral/magistral-small-latest": {},
        "mistral/magistral-medium-latest": {},
        "mistral/codestral-latest": {},
        "mistral/ministral-8b-latest": {},
        "mistral/pixtral-large-latest": {},
        "google/gemini-2.5-flash": {},
        "google/gemini-2.5-flash-lite": {},
        "google/gemini-2.5-pro": {},
        "google/gemini-3-flash-preview": {},
        "google/gemini-3.1-pro-preview": {}
      }
    },
    "entries": {
      "main": {
        "tools": {
          "profile": "messaging",
          "alsoAllow": [
            "web_fetch",
            "memory_search",
            "memory_get",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "browser",
            "canvas",
            "message",
            "cron",
            "gateway",
            "nodes",
            "agents_list",
            "exec",
            "process",
            "edit",
            "write",
            "read",
            "tts"
          ]
        }
      }
    }
  },
  "tools": {
    "profile": "messaging",
    "web": {
      "search": {
        "enabled": true
      },
      "fetch": {
        "enabled": true,
        "maxChars": 15000
      }
    }
  },
  "memory": {
    "search": {
      "provider": "lmstudio",
      "model": "${LM_STUDIO_EMBEDDING_MODEL:-text-embedding-nomic-embed-text-v1.5}",
      "remote": {
        "baseUrl": "${LM_STUDIO_URL:-http://host.docker.internal:1234/v1}",
        "apiKey": "${LM_STUDIO_API_KEY}"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "accounts": {
        "default": {
          "botToken": "${TELEGRAM_BOT_TOKEN}",
          "dmPolicy": "pairing",
          "groupPolicy": "allowlist",
          "streaming": {
            "mode": "partial"
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "composio": {
        "url": "https://connect.composio.dev/mcp",
        "transport": "streamable-http",
        "headers": {
          "x-consumer-api-key": "${COMPOSIO_API_KEY}"
        }
      }
    }
  },
  "approvals": {
    "exec": {
      "agentFilter": []
    }
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": true
      },
      "google": {
        "enabled": true
      },
      "mistral": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      }
    }
  },
  "skills": {
    "entries": {
      "openai-whisper-api": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      }
    }
  },
  // Upgrade bookkeeping. Doctor prints a patch for this block after each image
  // bump; without the migration markers it would also propose turning
  // agents.defaults.models into a modelPolicy allowlist on every start.
  "meta": {
    "lastTouchedVersion": "2026.11.4",
    "migrations": {
      "modelPolicyAllowlist": true,
      "webhookListeners": {
        "telegram": [],
        "feishu": [],
        "nextcloud-talk": []
      }
    }
  }
}
