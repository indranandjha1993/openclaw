{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "https://openclaw-gateway.openclaw.orb.local"
      ]
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "lm-studio": {
        "baseUrl": "http://host.docker.internal:1234/v1",
        "apiKey": "${LM_STUDIO_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "google/gemma-4-e2b",
            "name": "Gemma 4 E2B",
            "contextWindow": 32768,
            "maxTokens": 4096
          },
          {
            "id": "mistralai/ministral-3-3b-reasoning",
            "name": "Ministral 3 3B Reasoning",
            "contextWindow": 32768,
            "maxTokens": 4096
          },
          {
            "id": "qwen/qwen3.5-4b",
            "name": "Qwen3.5 4B",
            "contextWindow": 32768,
            "maxTokens": 4096
          },
          {
            "id": "nvidia/nemotron-3-nano-4b",
            "name": "Nemotron 3 Nano 4B",
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "lm-studio/google/gemma-4-e2b",
        "fallbacks": [
          "lm-studio/mistralai/ministral-3-3b-reasoning"
        ]
      },
      "models": {
        "lm-studio/google/gemma-4-e2b": {
          "alias": "gemma4e2b"
        },
        "lm-studio/mistralai/ministral-3-3b-reasoning": {
          "alias": "ministral33breasoning"
        },
        "lm-studio/qwen/qwen3.5-4b": {
          "alias": "qwen354b"
        },
        "lm-studio/nvidia/nemotron-3-nano-4b": {
          "alias": "nemotron3nano4b"
        }
      },
      "memorySearch": {
        "provider": "local"
      },
      "compaction": {
        "reserveTokensFloor": 20000
      }
    },
    "list": [
      {
        "id": "main",
        "model": "lm-studio/google/gemma-4-e2b",
        "tools": {
          "profile": "messaging",
          "alsoAllow": [
            "web_fetch",
            "web_search",
            "x_search",
            "memory_search",
            "memory_get",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "browser",
            "canvas",
            "message",
            "cron",
            "gateway",
            "nodes",
            "agents_list",
            "update_plan",
            "image",
            "image_generate",
            "music_generate",
            "video_generate",
            "tts",
            "exec",
            "process",
            "code_execution",
            "edit",
            "write",
            "read"
          ]
        }
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": true,
        "maxChars": 10000
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.4.8",
    "lastTouchedAt": "2026-04-08T12:09:18.360Z"
  },
  "channels": {
    "telegram": {
      "dmPolicy": "pairing",
      "botToken": "8581741522:AAH_mQCHE5Ox9unAE5MKo6PK66KCTzC8qdI",
      "groupPolicy": "allowlist",
      "accounts": {},
      "streaming": {
        "mode": "partial"
      },
      "enabled": true
    }
  },
  "approvals": {
    "exec": {
      "agentFilter": []
    }
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": true
      }
    }
  }
}
