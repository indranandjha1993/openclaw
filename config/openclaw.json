// Mounted read-only. Secrets and machine-specific values come from .env.
{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:${OPENCLAW_GATEWAY_PORT:-18789}",
        "http://127.0.0.1:${OPENCLAW_GATEWAY_PORT:-18789}"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "lmstudio": {
        "baseUrl": "${LM_STUDIO_URL:-http://localhost:1234/v1}",
        "apiKey": "${LM_STUDIO_API_KEY}",
        "api": "openai-completions",
        // Cold loads of a 9B model can take a while
        "timeoutSeconds": 300,
        // On 2026.11.4 the preload sends a secret placeholder instead of the
        // key and LM Studio rejects it. LM Studio loads models itself instead,
        // so set each model's context length (32768) in LM Studio.
        "params": {
          "preload": false
        },
        "models": [
          {
            "id": "qwen/qwen3.5-9b",
            "name": "Qwen 3.5 9B (Local)",
            "contextWindow": 32768
          },
          {
            "id": "nvidia/nemotron-3-nano-4b",
            "name": "Nemotron 3 Nano 4B (Local)",
            "contextWindow": 32768
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        // Gemini 2.5 rejects tool results from OpenClaw; 3.x handles them.
        "primary": "${OPENCLAW_MODEL:-google/gemini-3-flash-preview}",
        // The local model is the fallback: fine for short replies, too slow
        // on 16 GB for long tool-heavy turns.
        "fallbacks": [
          "lmstudio/qwen/qwen3.5-9b"
        ]
      },
      "models": {
        "google/gemini-3-flash-preview": {},
        "google/gemini-3.1-pro-preview": {},
        "lmstudio/qwen/qwen3.5-9b": {},
        "lmstudio/nvidia/nemotron-3-nano-4b": {}
      },
      // Routine check-ins run locally so they don't use the Gemini free-tier quota.
      "heartbeat": {
        "model": "lmstudio/qwen/qwen3.5-9b",
        "lightContext": true
      }
    },
    "entries": {
      "main": {
        "tools": {
          "profile": "messaging",
          "alsoAllow": [
            "web_search",
            "web_fetch",
            "memory_search",
            "memory_get",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "browser",
            "canvas",
            "message",
            "cron",
            "gateway",
            "nodes",
            "agents_list",
            "exec",
            "process",
            "edit",
            "write",
            "read",
            "tts"
          ]
        }
      }
    }
  },
  "tools": {
    "profile": "messaging",
    // Code Mode and Tool Search hide tools behind a code-execution tool or a
    // generic search/call tool. Both models guessed wrong arguments through
    // them, so they get the real tools directly.
    "codeMode": false,
    "toolSearch": false,
    "web": {
      "search": {
        "enabled": true,
        // Auto-detect picks Gemini grounding when GEMINI_API_KEY is set, and the
        // free tier returns 429 for it. DuckDuckGo needs no key.
        "provider": "duckduckgo"
      },
      "fetch": {
        "enabled": true,
        "maxChars": 15000
      }
    }
  },
  "memory": {
    "search": {
      "provider": "lmstudio",
      "model": "${LM_STUDIO_EMBEDDING_MODEL:-text-embedding-nomic-embed-text-v1.5}",
      "remote": {
        "baseUrl": "${LM_STUDIO_URL:-http://localhost:1234/v1}",
        "apiKey": "${LM_STUDIO_API_KEY}"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "accounts": {
        "default": {
          "botToken": "${TELEGRAM_BOT_TOKEN}",
          "dmPolicy": "pairing",
          "groupPolicy": "disabled",
          "streaming": {
            "mode": "partial"
          }
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_OWNER_ID}"
    ]
  },
  "browser": {
    "extensionRelay": {
      "allowLegacyAuth": false
    }
  },
  "mcp": {
    "servers": {
      "composio": {
        "url": "https://connect.composio.dev/mcp",
        "transport": "streamable-http",
        "headers": {
          "x-consumer-api-key": "${COMPOSIO_API_KEY}"
        }
      }
    }
  },
  "approvals": {
    "exec": {
      "agentFilter": []
    }
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": true
      },
      "google": {
        "enabled": true
      },
      "duckduckgo": {
        "enabled": true
      }
    }
  },
  "skills": {
    "entries": {
      "openai-whisper-api": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      }
    },
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  // Upgrade bookkeeping. Doctor prints a patch for this block after each image
  // bump; without the migration markers it would also propose turning
  // agents.defaults.models into a modelPolicy allowlist on every start.
  "meta": {
    "lastTouchedVersion": "2026.11.4",
    "migrations": {
      "modelPolicyAllowlist": true,
      "webhookListeners": {
        "telegram": [],
        "feishu": [],
        "nextcloud-talk": []
      }
    }
  }
}
