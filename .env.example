# cp .env.example .env
# Anything secret or machine-specific goes here. config/openclaw.json only
# references these as ${VAR}.

# Pinned image. Change the tag on purpose, then run `make upgrade`.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.11.4

# Dashboard port on the host (bound to 127.0.0.1 only)
OPENCLAW_PORT=18789

# Gateway auth token. Generate with `make token` or `openssl rand -hex 32`.
OPENCLAW_GATEWAY_TOKEN=

TZ=Asia/Kolkata

# Default model as provider/model-id. Cloud fallbacks are in config/openclaw.json.
OPENCLAW_MODEL=lm-studio/qwen/qwen3.5-9b

# LM Studio server (Developer tab). The container reaches the host through
# host.docker.internal, so keep that instead of localhost.
LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Cloud providers. Leave a key empty and that provider stays off.
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Composio MCP (optional)
COMPOSIO_API_KEY=
