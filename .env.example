# cp .env.example .env
# Anything secret or machine-specific goes here. config/openclaw.json only
# references these as ${VAR}.

# Pinned image. Change the tag on purpose, then run `make upgrade`.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.11.4

# Gateway and dashboard port, on 127.0.0.1 only
OPENCLAW_GATEWAY_PORT=18789

# Gateway auth token. Generate with `make token` or `openssl rand -hex 32`.
OPENCLAW_GATEWAY_TOKEN=

TZ=Asia/Kolkata

# Default model as provider/model-id (openai/* needs the ChatGPT sign-in, see README).
# Fallbacks are in config/openclaw.json.
OPENCLAW_MODEL=openai/gpt-6-astra

# LM Studio server (Developer tab). The gateway uses host networking, so
# localhost is this machine.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Telegram bot token from @BotFather, and your own Telegram user id
# (the command owner, allowed to run admin commands from chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Gemini, used as the cloud fallback when local models fail
GEMINI_API_KEY=

# Composio MCP (optional)
COMPOSIO_API_KEY=
